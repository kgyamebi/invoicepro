# Application
APP_NAME=InvoiceFlow
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=InvoiceFlow
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_TAGLINE=Professional invoices, quotations and receipts — without the expensive software.
NODE_ENV=development

# Database
DATABASE_URL=postgresql://invoice:invoice@localhost:5432/invoiceapp

# Redis / workers
REDIS_URL=redis://localhost:6379

# Auth
AUTH_SECRET=replace-with-a-long-random-secret
SESSION_DAYS=30
ADMIN_EMAIL=

# Google login (optional — leave empty to hide)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Object storage (optional — local disk used when unset)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_PUBLIC_URL=

# Payments — only enable providers you have keys for
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_PUBLIC_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# Email
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=noreply@localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# AI (optional)
AI_PROVIDER=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=

# Rate limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60
