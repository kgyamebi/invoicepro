# Application
APP_NAME=InvoiceFlow
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=InvoiceFlow
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_TAGLINE=Professional Invoicing for Every Small Business
NODE_ENV=development

# Database
# Add ?connection_limit=10 (or PgBouncer params) so web + worker share the pool budget.
DATABASE_URL=postgresql://invoice:invoice@localhost:5432/invoiceapp

# Redis / workers (optional in development — leave blank if Redis is not installed)
# REDIS_URL=redis://localhost:6379
REDIS_URL=

# After you confirm automated Postgres backups in staging/prod:
# BACKUP_VERIFIED=true

# Auth
AUTH_SECRET=replace-with-a-long-random-secret
SESSION_DAYS=30
ADMIN_EMAIL=
REQUIRE_EMAIL_VERIFICATION=false
# optional | prompt | required — default optional does not change login
MFA_ENFORCEMENT=optional

# Google login (optional — leave empty to hide)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Object storage (optional — local disk used when unset)
STORAGE_DRIVER=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_PUBLIC_URL=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=invoiceflow
AZURE_STORAGE_KEY=
WEBAUTHN_RP_ID=
SLOW_QUERY_MS=250

# Payments — only enable providers you have keys for
# Invoicing-only (no Pay Now): leave provider keys empty
PAYMENTS_REQUIRED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_WEBHOOK_SECRET_PREVIOUS=
# Optional: reject secret-key HMAC fallback (breaks Paystack default signing if the dashboard has no webhook secret)
# PAYSTACK_REQUIRE_DEDICATED_WEBHOOK_SECRET=true
PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_PUBLIC_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# Email — production MUST use smtp|resend (console fails startup). See docs/EMAIL_SETUP.md
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=noreply@localhost
# Resend sandbox (onboarding@resend.dev) only delivers to this mailbox
RESEND_ACCOUNT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# EMAIL_SYNC_DELIVER=true   # local drills only; never needed when the worker is running

# AI (optional)
AI_PROVIDER=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=

# Rate limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60

# Monitoring (optional in development; required for production observability)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# 1.0 in development; defaults to 0.1 when SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
